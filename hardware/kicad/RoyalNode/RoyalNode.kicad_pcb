(kicad_pcb
  (version 20250114)
  (generator "pcbnew")
  (generator_version "10.0")
  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )
  (paper "A")
  (title_block
    (title "RoyalNode Rev A")
    (date "2026-07-24")
    (rev "A")
    (company "RoyalNode")
    (comment 1 "Initial KiCad layout scaffold")
    (comment 2 "Not fabrication ready")
  )
  (layers
    (0 "F.Cu" signal)
    (1 "In1.Cu" power)
    (2 "In2.Cu" power)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
